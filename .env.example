EMBEDDING_DIMENSIONS=1536
MEMORY_CANDIDATE_LIMIT=5
MEMORY_MIN_SIMILARITY=0.75
APP_ENV=development
LOG_LEVEL=INFO
AUTH_TOKEN_SECRET=change-this-development-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Remote MCP plugin (OAuth + Telegram account linking)
MCP_ENABLED=false
MCP_PUBLIC_URL=https://your-host.example
MCP_ISSUER=
MCP_TOKEN_SECRET=change-this-development-mcp-secret
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_LINK_TTL_SECONDS=600


VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_REQUEST_DEADLINE_SECONDS=6
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_VOICE_MODEL=
