# or minimal_top_level (removes voice and tools while retaining the caller prompt).
VAPI_ASSISTANT_RESPONSE_MODE=message_response
# Needed only for the explicit `uv run sync-vapi-assistant` command.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SERVER_URL=
VAPI_CREDENTIAL_ID=

# Optional Google Calendar integration
