STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=
TELEGRAM_VOICE_MAX_DURATION_SECONDS=120
TELEGRAM_VOICE_MAX_BYTES=10485760
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
GEMINI_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
